@page "/audit-log"
@inherits OperatorComponentBase
@inject IAuditReader Audit

<PageTitle>Audit log</PageTitle>

<h1 class="h3 mb-3">Audit log</h1>
@if (Entries.Count == 0)
{
    <p class="text-muted" id="audit-log-empty">No operator actions have been recorded.</p>
}
else
{
    <table class="table table-sm table-striped" id="audit-log">
        <thead><tr><th>At</th><th>Operator</th><th>Action</th><th>Target</th><th>Detail</th></tr></thead>
        <tbody>
            @foreach (var (entry, index) in Entries.Select((entry, index) => (entry, index)))
            {
                <tr id="@DisplayMapper.ElementId(ElementIds.AuditLogRow, index)">
                    <td>@DisplayMapper.Timestamp(entry.At)</td>
                    <td class="font-monospace">@entry.OperatorId.ToString("N")</td>
                    <td>@entry.Action</td>
                    <td>@entry.TargetId</td>
                    <td>@entry.Detail</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const int PageSize = 200;

    private IReadOnlyList<AuditEntry> Entries { get; set; } = [];

    protected override async Task OnOperatorReadyAsync() => Entries = await Audit.ReadLatestAsync(PageSize);
}
