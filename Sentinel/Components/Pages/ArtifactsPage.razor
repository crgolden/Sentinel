@page "/artifacts"
@inherits OperatorComponentBase
@inject IListenerDirectory Directory
@inject IFeedReader Feeds

<PageTitle>Artifacts</PageTitle>

<h1 class="h3 mb-3">Artifacts</h1>
@foreach (var group in Groups)
{
    <h2 class="h5 mt-4">@group.DisplayName</h2>
    <ArtifactList Items="group.Items" Id="@DisplayMapper.ElementId(ElementIds.ListenerArtifacts, group.ListenerId)" />
}
@if (Groups.Count == 0)
{
    <p class="text-muted" id="artifacts-none">No listener has published artifacts.</p>
}

@code {
    private IReadOnlyList<ArtifactGroup> Groups { get; set; } = [];

    protected override async Task OnOperatorReadyAsync()
    {
        List<ArtifactGroup> groups = [];
        foreach (var listener in Directory.Listeners)
        {
            if (await Feeds.GetArtifactsAsync(listener.Id) is { Items.Count: > 0 } feed)
            {
                groups.Add(new ArtifactGroup(listener.Id, listener.Definition.DisplayName, [.. feed.Items.OrderByDescending(item => item.ProducedAt)]));
            }
        }

        Groups = groups;
    }
}
