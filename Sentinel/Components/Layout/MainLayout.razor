@inherits LayoutComponentBase

<header>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/" id="nav-brand">Sentinel</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><NavLink class="nav-link" href="/" Match="NavLinkMatch.All" id="nav-dashboard">Dashboard</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="chat" id="nav-chat">Sentinel chat</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="approvals" id="nav-approvals">Approvals</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="board" id="nav-board">Board</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="audits" id="nav-audits">Audits</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="artifacts" id="nav-artifacts">Artifacts</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="audit-log" id="nav-audit-log">Audit log</NavLink></li>
            </ul>
            <form method="post" action="@PageRoutes.Logout" class="ms-auto" data-enhance="false">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-outline-light btn-sm" id="logout">Log out</button>
            </form>
        </div>
    </nav>
</header>

<main role="main" class="container-fluid py-4">
    @Body
</main>
